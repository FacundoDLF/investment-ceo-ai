// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StrategyType {
  LONG_TERM
  INTRADAY
}

model Account {
  id        String   @id @default(uuid())
  balance   Float    @default(100.0)
  status    String   @default("ACTIVE") // ACTIVE, LIQUIDATED, PAUSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Challenge {
  id           String   @id @default(uuid())
  tier         Int
  title        String
  description  String
  targetMetric Float
  status       String   @default("LOCKED") // LOCKED, ACTIVE, COMPLETED, FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketInsight {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  context       String   // e.g. "Impacto por captura geopolítica = Riesgo ALTO"
  severity      String   // HIGH, MEDIUM, LOW
  deducedAction String   // e.g. "Hedge positions with USD", "Reduce leverage"
  marketTarget  String   // e.g. "WALL_STREET", "BYMA", "GLOBAL"
}

model CeoMemory {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // Store JSON stringified or raw string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExecutionLog {
  id        String       @id @default(uuid())
  timestamp DateTime     @default(now())
  eventType String       // e.g. "PRICE_CHECK", "TRADE_ORDER", "MARKET_RESEARCH"
  venue     String?      // e.g. "alpaca", "bybit"
  symbol    String?      // e.g. "AAPL", "BTCUSDT"
  details   String       // JSON stringified details
  strategy  StrategyType @default(LONG_TERM)
  success   Boolean      @default(true)
}

model Position {
  id        String       @id @default(uuid())
  venue     String       // e.g. "alpaca", "bybit"
  symbol    String       // e.g. "AAPL", "BTCUSDT"
  strategy  StrategyType @default(LONG_TERM)
  thesis    String?      @db.Text // Tesis de inversión para el self-reflection
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([venue, symbol])
}

model PerformanceSnapshot {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  totalEquity    Float
  unrealizedPnL  Float
  notes          String?
}
